# Backend Environment Variables
# Copy this to .env and fill in the real values

# Server
PORT=4000
NODE_ENV=development
COLLEGE_EMAIL_DOMAIN=bitsathy.ac.in
ADMIN_EMAIL=admin@bitsathy.ac.in

# Firebase Admin SDK
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-private-key-here\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# TiDB Serverless (MySQL-compatible via Prisma)
# Format: mysql://user:pass@host:4000/dbname?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/contest?ssl={'rejectUnauthorized':true}"

# Redis (Render Free Redis)
REDIS_URL=redis://localhost:6379

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-20240307

# Piston API (public, no key needed)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Contest Settings
CONTEST_DURATION_MINUTES=180
MAX_PARTICIPANTS=500
SKIP_LOCKOUT_MINUTES=10

# AP Formula Weights
AP_AI_WEIGHT=0.3
AP_BASE_EASY=100
AP_BASE_MEDIUM=200
AP_BASE_HARD=350

# CORS
FRONTEND_URL=http://localhost:5173
